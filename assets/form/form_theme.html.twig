{% use 'form_div_layout.html.twig' %}

{#- The attributes of a field someone may read but not change.

    `readonly`, and not `disabled`, although it is Symfony's `disabled` option
    that decides it. `disabled` greys the control, takes it out of the tab order
    and is passed over by most screen readers: it says "unavailable" where the
    truth is "settled". `readonly` leaves the field focusable, readable and
    selectable.

    Nothing is lost by rendering the gentler attribute, because neither of them
    is what protects the value: Symfony ignores whatever is submitted for a
    disabled field, so a forged post changes nothing even though the browser
    sent the field. -#}
{% block wex_frozen_attributes %}{% if form.vars.disabled ?? false %}readonly aria-readonly="true"{% endif %}{% endblock %}

{#- The attributes an input element carries besides its value: the ones Symfony
    computes for the type and the browser needs to take the input — `inputmode`
    for the keyboard of a localized number, `step` for an HTML5 one, which
    refuses every decimal without it —, the bounds a form may set on what is
    typed (`min`, `max`, `maxlength`, `pattern`), then the frozen ones. -#}
{% block wex_input_attributes %}
    {%- for attribute in ['inputmode', 'step', 'min', 'max', 'maxlength', 'pattern'] -%}
        {%- if attr[attribute] is defined %} {{ attribute }}="{{ attr[attribute] }}"{% endif -%}
    {%- endfor %} {{ block('wex_frozen_attributes') -}}
{% endblock %}

{#- A control HTML cannot freeze — a select, a radio group, a switch, a file
    field — shown as the value it holds, in a field that is read and not
    written. It carries no `name`, so nothing of it reaches the server at all. -#}
{% block wex_frozen_value_widget %}
    {{ component(
        render_pass,
        '@WexampleSymfonyDesignSystemBundle/components/form/text-input',
        {
            id: id,
            label: frozen_label,
            value: frozen_value,
            input_attr: 'readonly aria-readonly="true"'
        }
    ) }}
{% endblock %}

{#- What a frozen choice field says: the labels of what is selected, read from
    the same `choices` the editable rendering walks, so a label translated in
    one is translated in the other. -#}
{% block wex_frozen_choice_label %}
{%- set selected = form.vars.value is iterable ? form.vars.value : [form.vars.value] -%}
{%- set labels = [] -%}
{%- for choice in form.vars.choices -%}
    {%- if choice.choices is defined -%}
        {%- for option in choice.choices -%}
            {%- if option.value in selected -%}
                {%- set labels = labels|merge([option.label|trans]) -%}
            {%- endif -%}
        {%- endfor -%}
    {%- elseif choice.value in selected -%}
        {%- set labels = labels|merge([choice.label|trans]) -%}
    {%- endif -%}
{%- endfor -%}
{{- labels|join(', ') -}}
{% endblock %}

{% block form_row %}
    {% set row_attr = row_attr|default({}) %}
    {% set row_classes = (row_attr.class ?? '') ~ ' form--group' %}
    {% set required_mode = form.parent is not null ? (form.parent.vars.required_mode ?? 'optional') : 'optional' %}
    {% if errors|length > 0 %}
        {% set row_classes = row_classes ~ ' has-error' %}
    {% endif %}
    {% if required_mode == 'asterisk' and required is defined and required %}
        {% set row_classes = row_classes ~ ' is-required' %}
    {% elseif required_mode == 'optional' and (required is not defined or not required) %}
        {% set row_classes = row_classes ~ ' is-optional' %}
    {% endif %}
    {% set row_attr = row_attr|merge({ class: row_classes|trim }) %}
    {% set attr = row_attr %}
    <div {{ block('attributes')|raw }}>
        {{ form_widget(form) }}
        {{ form_errors(form) }}
        {{ form_help(form) }}
    </div>
{% endblock %}

{% block form_widget_compound %}
    {{ form_errors(form) }}
    {{ block('form_rows') }}
    {{ form_rest(form) }}
{% endblock %}

{% block form_start %}
    {% set attr = attr|merge({ class: (attr.class ?? '') ~ ' form' }) %}
    {#- Read by the loader's form, which holds the submit button meanwhile. -#}
    {% if submit_when_valid ?? false %}
        {% set attr = attr|merge({ 'data-submit-when-valid': '' }) %}
    {% endif %}
    {#- Read by the loader's form, which sends it on every settled change. -#}
    {% if submit_on_change ?? false %}
        {% set attr = attr|merge({ 'data-submit-on-change': '' }) %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block form_end %}
    {{ parent() }}
{% endblock %}

{% block form_widget_simple %}
    {% set frozen = form.vars.disabled ?? false %}
    {% set label_key = form.vars.label is same as(false)
        ? form.vars.name
        : (form.vars.label ?? form.vars.name)
    %}
    {% if label_key is same as(true) %}
        {% set label_key = 'field.' ~ form.vars.name ~ '.label' %}
    {% endif %}
    {% set label_value = form.vars.translation_domain is same as(false)
        ? label_key
        : label_key|trans(form.vars.label_translation_parameters ?? {}, form.vars.translation_domain)
    %}
    {% set placeholder_key = attr.placeholder ?? null %}
    {% if placeholder_key is same as(true) %}
        {% set placeholder_key = 'field.' ~ form.vars.name ~ '.placeholder' %}
    {% endif %}
    {% set placeholder_value = placeholder_key %}
    {% if placeholder_key is not null and form.vars.translation_domain is not same as(false) %}
        {% set placeholder_value = placeholder_key|trans({}, form.vars.translation_domain) %}
    {% endif %}
    {% set addon_domain = form.vars.translation_domain %}
    {% set prefix = form.vars.prefix ?? null %}
    {% set suffix = form.vars.suffix ?? null %}
    {% if addon_domain is not same as(false) %}
        {% set prefix = prefix is null ? null : prefix|trans({}, addon_domain) %}
        {% set suffix = suffix is null ? null : suffix|trans({}, addon_domain) %}
    {% endif %}
    {{ component(
        render_pass,
        '@WexampleSymfonyDesignSystemBundle/components/form/text-input',
        {
            type: type ?? 'text',
            name: full_name,
            id: id,
            label: label_value,
            placeholder: frozen ? null : placeholder_value,
            required: frozen ? false : required,
            value: value,
            input_attr: block('wex_input_attributes'),
            prefix: prefix,
            suffix: suffix
        }
    ) }}
{% endblock %}

