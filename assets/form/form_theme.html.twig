{#- A value shown among the fields without being one: `DisplayValueType` renders
    no element a browser submits and binds nothing to the model, so there is no
    field to forge. An empty one is said with a dash — a blank space reads as
    something missing from the page, a dash as something missing from the thing
    described. -#}
{% block display_value_widget %}
    {% set label_key = form.vars.label is same as(false)
        ? form.vars.name
        : (form.vars.label ?? form.vars.name)
    %}
    {% if label_key is same as(true) %}
        {% set label_key = 'field.' ~ form.vars.name ~ '.label' %}
    {% endif %}
    {% set label_value = form.vars.translation_domain is same as(false)
        ? label_key
        : label_key|trans(form.vars.label_translation_parameters ?? {}, form.vars.translation_domain)
    %}
    <div class="form--group form--group--display" id="{{ id }}">
        <span class="form--label">{{ label_value }}</span>
        {% if value is empty %}
            <span class="form--display-value form--display-value--empty">&mdash;</span>
        {% else %}
            <span class="form--display-value">{{ value }}</span>
        {% endif %}
    </div>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        {% if form.parent is null %}
            <div class="form--errors">
                <ul>
                    {% for error in errors %}
                        <li>{{ error.message | trans(error.messageParameters) }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            <div class="form--field-errors">
                <ul>
                    {% for error in errors %}
                        <li>{{ error.message | trans(error.messageParameters) }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block form_help %}
    {% if help is not empty %}
        {% set help_key = help %}
        {% if help_key is same as(true) %}
            {% set help_key = 'field.' ~ form.vars.name ~ '.help' %}
        {% endif %}
        <div class="form--help">
            {{ help_key|trans(help_translation_parameters, translation_domain) }}
        </div>
    {% endif %}
{% endblock %}
