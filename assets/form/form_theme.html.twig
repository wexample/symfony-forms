{% block switch_input_widget %}
    {% set label_key = form.vars.label is same as(false)
        ? form.vars.name
        : (form.vars.label ?? form.vars.name)
    %}
    {% if label_key is same as(true) %}
        {% set label_key = 'field.' ~ form.vars.name ~ '.label' %}
    {% endif %}
    {% set label_value = form.vars.translation_domain is same as(false)
        ? label_key
        : label_key|trans(form.vars.label_translation_parameters ?? {}, form.vars.translation_domain)
    %}
    {% if form.vars.disabled ?? false %}
        {% set frozen_label = label_value %}
        {#- A switch has no choices to read a label from, so it reads the two
            keys a radio group would have had. Translated as the label above
            it is, and left as the key when the form declares no domain. -#}
        {% set state_key = '@form::field.' ~ form.vars.name ~ '.choice.' ~ (form.vars.checked ? '1' : '0') ~ '.label' %}
        {% set frozen_value = form.vars.translation_domain is same as(false) ? state_key : state_key|trans %}
        {{ block('wex_frozen_value_widget') }}
    {% else %}
        {{ component(
            render_pass,
            '@WexampleSymfonyDesignSystemBundle/components/form/switch-input',
            {
                name: full_name,
                id: id,
                label: label_value,
                required: required,
                checked: form.vars.checked ?? false,
                value: form.vars.value ?? '1'
            }
        ) }}
    {% endif %}
{% endblock %}

{#- A value taken along a scale, its value said beside the label as it moves.
    Frozen, the value it holds and its suffix, in a field read and not written. -#}
{% block range_input_widget %}
    {% set label_key = form.vars.label is same as(false)
        ? form.vars.name
        : (form.vars.label ?? form.vars.name)
    %}
