    {% endif %}
    {% set label_value = form.vars.translation_domain is same as(false)
        ? label_key
        : label_key|trans(form.vars.label_translation_parameters ?? {}, form.vars.translation_domain)
    %}
    {% set placeholder_key = attr.placeholder ?? null %}
    {% if placeholder_key is same as(true) %}
        {% set placeholder_key = 'field.' ~ form.vars.name ~ '.placeholder' %}
    {% endif %}
    {% set placeholder_value = placeholder_key %}
    {% if placeholder_key is not null and form.vars.translation_domain is not same as(false) %}
        {% set placeholder_value = placeholder_key|trans({}, form.vars.translation_domain) %}
    {% endif %}
    {% set addon_domain = form.vars.translation_domain %}
    {% set prefix = form.vars.prefix ?? null %}
    {% set suffix = form.vars.suffix ?? null %}
    {% if addon_domain is not same as(false) %}
        {% set prefix = prefix is null ? null : prefix|trans({}, addon_domain) %}
        {% set suffix = suffix is null ? null : suffix|trans({}, addon_domain) %}
    {% endif %}
    {#- `<input type="number">` holds no decimal comma: a French `72,5` written into
        one shows an empty field, and a browser refuses the comma typed in it.
        So the number field is kept for `html5: true`, where Symfony writes and
        reads a point whatever the locale, and a localized number is a text
        input asking for a decimal keyboard. -#}
    {% set html5_number = (type ?? null) == 'number' %}
    {{ component(
        render_pass,
        '@WexampleSymfonyDesignSystemBundle/components/form/'
            ~ (html5_number ? 'number-input' : 'text-input'),
        {
            type: html5_number ? 'number' : 'text',
            name: full_name,
            id: id,
            label: label_value,
            placeholder: frozen ? null : placeholder_value,
            required: frozen ? false : required,
            value: value,
            input_attr: block('wex_input_attributes'),
            prefix: prefix,
            suffix: suffix
        }
    ) }}
{% endblock %}

