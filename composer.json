{
  "name": "wexample/symfony-forms",
  "description": "Forms management for Symfony design system",
  "type": "library",
  "license": "MIT",
  "version": "10.0.3",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyForms\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "wexample/symfony-design-system": ">=31.0.0",
    "syrtis/php-semantic-schema-web": ">=0.0.19",
    "symfony/form": "^7.4 || ^8.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyForms\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4",
    "symfony/security-core": "^7.4 || ^8.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}